{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Login.spec.ts",
            "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
            "args": ["test", "src/tests/Login.spec.ts", "--project=chromium", "--headed", "--workers=1", "--timeout=0"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug current spec file",
            "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
            "args": ["test", "${relativeFile}", "--project=chromium", "--headed", "--workers=1", "--timeout=0"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug all tests",
            "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
            "args": ["test", "--project=chromium", "--headed", "--workers=1", "--timeout=0"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
